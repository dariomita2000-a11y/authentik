[
 {
  "text": "Du machst Musik an.",
  "start": 0.0,
  "end": 1.22141
 },
 {
  "text": "Setzt deine Kopfhörer auf.",
  "start": 2.26567,
  "end": 3.79592
 },
 {
  "text": "Und läufst durch dein Zimmer.",
  "start": 4.54111,
  "end": 6.595715853658537
 },
 {
  "text": "Hin… und her.",
  "start": 6.595715853658537,
  "end": 7.36361
 },
 {
  "text": "Aber in Gedanken bist du längst woanders.",
  "start": 8.06349,
  "end": 10.6855
 },
 {
  "text": "Du lebst ein anderes Leben.",
  "start": 11.2497,
  "end": 12.6714
 },
 {
  "text": "Menschen sehen dich an.",
  "start": 13.3433,
  "end": 14.5855
 },
 {
  "text": "Du führst Gespräche, die nie stattgefunden haben… mit einem Menschen, den du vermisst.",
  "start": 15.2842,
  "end": 21.1425
 },
 {
  "text": "Für einen Moment ist diese Welt echter als deine eigene.",
  "start": 21.9019,
  "end": 25.4784
 },
 {
  "text": "Dann endet das Lied.",
  "start": 26.6277,
  "end": 28.0129
 },
 {
  "text": "Und du stehst wieder in deinem Zimmer.",
  "start": 28.5129,
  "end": 30.1046
 },
 {
  "text": "Allein.",
  "start": 30.6569,
  "end": 31.1129
 },
 {
  "text": "Man nennt es Maladaptive Daydreaming.",
  "start": 32.2267,
  "end": 34.5441
 },
 {
  "text": "Tagträume, so lebendig, dass sie das echte Leben verdrängen können.",
  "start": 35.0049,
  "end": 39.1126
 },
 {
  "text": "Und manchmal vermisst du nicht nur einen Menschen… sondern ein ganzes Leben, das nie Wirklichkeit geworden ist.",
  "start": 40.0215,
  "end": 47.49
 }
]